.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.DS_Store

# Experiment OUTPUTS are never committed. They are produced on the cluster and
# regenerated by the code from the configs, and committing them makes `git pull`
# on the cluster abort (untracked result files there collide with incoming ones).
# Move results between machines with slurm/package_results.sh + scp, and archive
# them separately for submission.
results/
cluster_run/
nlp_results_*.tar.gz

# LaTeX build output (the figures in abstract/figures/ ARE tracked)
abstract/*.pdf
abstract/*.aux
abstract/*.log
abstract/*.out
abstract/*.bbl
abstract/*.blg

# Slurm logs (written next to the repo root on the cluster)
slurm/logs/*.out
slurm/logs/*.err
!slurm/logs/.gitkeep
